# ─── Build ──────────────────────────────────────────────────────────────────
target/
dist/
*.class

# ─── Dati personali (mai nel repo) ──────────────────────────────────────────
# Il DB reale vive su OneDrive; luca.db in root e' la copia di sviluppo.
*.db
*.db-shm
*.db-wal
*.db.bak
*.db.bak-*
backups/
allegati/
# Coda pendenti dal telefono: dati runtime locali
pending.jsonl

# ─── Configurazione locale della macchina ───────────────────────────────────
# Contiene db.path e la porta HTTP: e' diverso su ogni installazione.
settings.properties

# ─── Log ────────────────────────────────────────────────────────────────────
*.log
run*.log
debug.log

# ─── Artefatti di verifica e diagnostica ────────────────────────────────────
# PNG di screenshot.ps1 / check-ui.ps1 / interact.ps1. Usa-e-getta: build.bat
# li cancella a ogni deploy (fase 6).
tools/screenshots/
# Dump di `mvn dependency:tree`, rigenerabile su richiesta
deps.txt

# ─── IDE ────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.VSCodeCounter/

# ─── Claude Code ────────────────────────────────────────────────────────────
# Config locale esclusa, ma i comandi di progetto sono versionati.
.claude/*
!.claude/commands/

# ─── OS ─────────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store

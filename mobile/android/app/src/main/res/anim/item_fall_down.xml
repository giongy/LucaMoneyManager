<?xml version="1.0" encoding="utf-8"?>
<!-- Animazione di ingresso di ogni item: fade + leggero slide dall'alto + scala.
     Usata dal layoutAnimation del RecyclerView conti. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@android:interpolator/decelerate_quint">

    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"/>

    <translate
        android:fromYDelta="-12%"
        android:toYDelta="0"/>

    <scale
        android:fromXScale="0.96"
        android:toXScale="1.0"
        android:fromYScale="0.96"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="0%"/>

</set>

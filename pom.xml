<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.moneymanager</groupId>
    <artifactId>moneymanager</artifactId>
    <version>1.24.3</version>
    <packaging>jar</packaging>
    <name>LucaMoneyManager</name>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JCEF - Chromium embedded (scarica binari automaticamente al primo avvio) -->
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>146.0.10</version>
        </dependency>
        <!-- SQLite JDBC (include nativi pre-compilati Windows/Mac/Linux, zero compilazione) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.0</version>
        </dependency>
        <!-- JSON serialization -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>
        <!-- Silenzia warning SLF4J "Failed to load StaticLoggerBinder" (transitivo da jcefmaven) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.17</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Solo version.properties va filtrato (inietta @project.version@).
                 Il resto (web/ con decine di file JS/CSS) viene copiato SENZA filtering:
                 evita che Maven riscriva ogni file via .tmp, causa di race con OneDrive/auto-save
                 (NoSuchFileException del resources-plugin durante il Run in IDE). -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>version.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>version.properties</exclude>
                </excludes>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                </configuration>
            </plugin>

            <!-- Avvio diretto con mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>com.moneymanager.App</mainClass>
                    <jvmArgs>
                        <jvmArg>--enable-native-access=ALL-UNNAMED</jvmArg>
                    </jvmArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-icon</id>
                        <phase>prepare-package</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>com.moneymanager.IconFactory</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/icon.ico</argument>
                            </arguments>
                            <classpathScope>runtime</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Fat JAR con tutte le dipendenze incluse -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.moneymanager.App</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Nativi JOGL (da jcefmaven): teniamo solo windows-amd64 -->
                                        <exclude>natives/macosx-universal/**</exclude>
                                        <exclude>natives/linux-aarch64/**</exclude>
                                        <exclude>natives/linux-amd64/**</exclude>
                                        <exclude>natives/linux-armv6hf/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- web/ è servita dal filesystem (cartella accanto al .exe), non dal JAR -->
                                <filter>
                                    <artifact>com.moneymanager:moneymanager</artifact>
                                    <excludes>
                                        <exclude>web/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- sqlite-jdbc include i nativi di tutte le piattaforme/architetture:
                                     l'app gira solo su Windows x86_64 (JRE 64-bit), quindi teniamo solo
                                     org/sqlite/native/Windows/x86_64 ed escludiamo tutto il resto (~11 MB) -->
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Linux/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Android/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                                        <exclude>org/sqlite/native/Mac/**</exclude>
                                        <exclude>org/sqlite/native/Windows/x86/**</exclude>
                                        <exclude>org/sqlite/native/Windows/armv7/**</exclude>
                                        <exclude>org/sqlite/native/Windows/aarch64/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
